{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "standard": {
      "format": "[%(asctime)s %(process)d %(name)s] %(levelname)s %(message)s"
    }
  },
  "handlers": {
    "console": {
      "class": "logging.StreamHandler",
      "formatter": "standard",
      "stream": "ext://sys.stderr"
    }
  },
  "root": {
    "level": "INFO",
    "handlers": [
      "console"
    ]
  },
  "loggers": {
    "tilelang": {
      "level": "INFO",
      "handlers": [
        "console"
      ],
      "propagate": false
    },
    "httpx": {
      "level": "WARNING"
    },
    "httpcore": {
      "level": "WARNING"
    }
  }
}